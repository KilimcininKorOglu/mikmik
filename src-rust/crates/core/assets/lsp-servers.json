[
  {
    "name": "rust-analyzer",
    "command": "rust-analyzer",
    "args": [],
    "file_patterns": ["*.rs"],
    "root_markers": ["Cargo.toml", "rust-analyzer.toml"],
    "language_id": "rust",
    "settings": { "rust-analyzer": { "checkOnSave": false } },
    "capabilities": {
      "flycheck": true,
      "ssr": true,
      "expand_macro": true,
      "runnables": true,
      "related_tests": true
    }
  },
  {
    "name": "clangd",
    "command": "clangd",
    "args": ["--background-index", "--clang-tidy", "--header-insertion=iwyu"],
    "file_patterns": ["*.c", "*.cpp", "*.cc", "*.cxx", "*.h", "*.hpp", "*.hxx", "*.m", "*.mm"],
    "root_markers": ["compile_commands.json", "CMakeLists.txt", ".clangd", ".clang-format"]
  },
  {
    "name": "zls",
    "command": "zls",
    "args": [],
    "file_patterns": ["*.zig"],
    "root_markers": ["build.zig", "build.zig.zon", "zls.json"],
    "language_id": "zig"
  },
  {
    "name": "gopls",
    "command": "gopls",
    "args": ["serve"],
    "file_patterns": ["*.go", "*.mod", "*.sum"],
    "root_markers": ["go.mod", "go.work", "go.sum"],
    "extension_to_language": { ".go": "go", ".mod": "go.mod", ".sum": "go.sum" },
    "settings": {
      "gopls": {
        "analyses": { "unusedparams": true, "shadow": true },
        "staticcheck": true,
        "gofumpt": true
      }
    }
  },
  {
    "name": "typescript-language-server",
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs"],
    "root_markers": ["package.json", "tsconfig.json", "jsconfig.json"],
    "initialization_options": {
      "hostInfo": "mikmik",
      "preferences": {
        "includeInlayParameterNameHints": "all",
        "includeInlayVariableTypeHints": true,
        "includeInlayFunctionParameterTypeHints": true
      }
    }
  },
  {
    "name": "denols",
    "command": "deno",
    "args": ["lsp"],
    "file_patterns": ["*.ts", "*.tsx", "*.js", "*.jsx"],
    "root_markers": ["deno.json", "deno.jsonc", "deno.lock"],
    "initialization_options": { "enable": true, "lint": true, "unstable": true }
  },
  {
    "name": "biome",
    "command": "biome",
    "args": ["lsp-proxy"],
    "file_patterns": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs", "*.json", "*.jsonc", "*.css"],
    "root_markers": ["biome.json", "biome.jsonc"],
    "is_linter": true
  },
  {
    "name": "eslint",
    "command": "vscode-eslint-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs", "*.vue", "*.svelte"],
    "root_markers": [
      ".eslintrc",
      ".eslintrc.js",
      ".eslintrc.json",
      ".eslintrc.yml",
      "eslint.config.js",
      "eslint.config.mjs"
    ],
    "is_linter": true,
    "settings": { "validate": "on", "run": "onType" }
  },
  {
    "name": "vscode-html-language-server",
    "command": "vscode-html-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.html", "*.htm"],
    "root_markers": ["package.json"],
    "initialization_options": { "provideFormatter": true }
  },
  {
    "name": "vscode-css-language-server",
    "command": "vscode-css-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.css", "*.scss", "*.sass", "*.less"],
    "root_markers": ["package.json"],
    "initialization_options": { "provideFormatter": true }
  },
  {
    "name": "vscode-json-language-server",
    "command": "vscode-json-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.json", "*.jsonc"],
    "root_markers": ["package.json"],
    "initialization_options": { "provideFormatter": true }
  },
  {
    "name": "tailwindcss",
    "command": "tailwindcss-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.html", "*.css", "*.scss", "*.js", "*.jsx", "*.ts", "*.tsx", "*.vue", "*.svelte"],
    "root_markers": [
      "tailwind.config.js",
      "tailwind.config.ts",
      "tailwind.config.mjs",
      "tailwind.config.cjs"
    ]
  },
  {
    "name": "svelte",
    "command": "svelteserver",
    "args": ["--stdio"],
    "file_patterns": ["*.svelte"],
    "root_markers": ["svelte.config.js", "svelte.config.mjs"],
    "language_id": "svelte"
  },
  {
    "name": "vue-language-server",
    "command": "vue-language-server",
    "args": ["--stdio"],
    "file_patterns": ["*.vue"],
    "root_markers": ["vue.config.js", "nuxt.config.js", "nuxt.config.ts"],
    "language_id": "vue"
  },
  {
    "name": "astro",
    "command": "astro-ls",
    "args": ["--stdio"],
    "file_patterns": ["*.astro"],
    "root_markers": ["astro.config.mjs", "astro.config.js", "astro.config.ts"],
    "language_id": "astro"
  },
  {
    "name": "pyright",
    "command": "pyright-langserver",
    "args": ["--stdio"],
    "file_patterns": ["*.py", "*.pyi"],
    "root_markers": [
      "pyproject.toml",
      "pyrightconfig.json",
      "setup.py",
      "setup.cfg",
      "requirements.txt",
      "Pipfile"
    ],
    "language_id": "python",
    "settings": {
      "python": {
        "analysis": {
          "autoSearchPaths": true,
          "diagnosticMode": "openFilesOnly",
          "useLibraryCodeForTypes": true
        }
      }
    }
  },
  {
    "name": "basedpyright",
    "command": "basedpyright-langserver",
