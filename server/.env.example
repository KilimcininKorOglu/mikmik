# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Generate a secret:
#   openssl rand -hex 32
#
# At least 32 characters. The server refuses to start below that, because this
# secret encrypts every stored provider key and every settings backup, and
# derives every session token.
MIKMIK_SERVER_SECRET=

# Optional overrides.
# MIKMIK_SERVER_BIND=0.0.0.0:8420
# MIKMIK_SERVER_DB=/data/mikmik-server.sqlite
# RUST_LOG=mikmik_server=debug
