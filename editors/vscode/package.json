{
  "name": "mikmik-vscode",
  "displayName": "MikMik",
  "description": "Chat with MikMik, an AI coding agent, without leaving VS Code.",
  "version": "1.0.1",
  "publisher": "kilimcininkoroglu",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KilimcininKorOglu/mikmik.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "ai",
    "agent",
    "chat",
    "acp",
    "mikmik"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onWebviewPanel:mikmikChat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mikmik.openChat",
        "title": "MikMik: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mikmik.newSession",
        "title": "MikMik: New Session"
      },
      {
        "command": "mikmik.stopSession",
        "title": "MikMik: Stop Current Turn"
      },
      {
        "command": "mikmik.resumeSession",
        "title": "MikMik: Resume Session"
      },
      {
        "command": "mikmik.forkSession",
        "title": "MikMik: Fork Session"
      },
      {
        "command": "mikmik.sendSelection",
        "title": "MikMik: Send Selection to Chat"
      }
    ],
    "keybindings": [
      {
        "command": "mikmik.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "mikmik.sendSelection",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "mikmik.stopSession",
        "key": "escape",
        "when": "mikmik.busy"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mikmik.openChat"
        },
        {
          "command": "mikmik.newSession"
        },
        {
          "command": "mikmik.stopSession"
        },
        {
          "command": "mikmik.resumeSession"
        },
        {
          "command": "mikmik.forkSession"
        },
        {
          "command": "mikmik.sendSelection"
        }
      ],
      "editor/context": [
        {
          "command": "mikmik.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mikmik",
          "title": "MikMik",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mikmik": [
        {
          "type": "webview",
          "id": "mikmik.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "MikMik",
      "properties": {
        "mikmik.executablePath": {
          "type": "string",
          "default": "mikmik",
          "description": "Path to the mikmik executable. Defaults to resolving 'mikmik' from PATH."
        },
        "mikmik.hostTerminals": {
          "type": "boolean",
          "default": false,
          "description": "Run the agent's shell commands in this extension instead of in the agent, so their output appears live in the chat panel. Off by default: the agent runs commands in a real PTY, and this runs them on a pipe, so anything that checks whether it is attached to a terminal (npm, cargo, git, pytest) behaves differently."
        },
        "mikmik.requestTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "How long to wait for the agent to answer a request before reporting it as failed. Does not apply to a running turn, which lasts as long as the model and its tools take and is ended with Stop."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p ./ && tsc -p src/webview && tsc -p test",
    "test": "node esbuild.mjs --tests && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0"
  }
}
